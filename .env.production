ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# Database
DATABASE_URL=sqlite:///session_analytics.db

# Cache Settings
CACHE_DIR=/app/cache
OUTPUTS_DIR=/app/outputs
